# Obrigatório — gere um valor seguro para produção (ex.: openssl rand -hex 32)
JWT_SECRET=troque-em-producao-use-uma-string-longa-e-aleatoria

# Opcional — senha do PostgreSQL (default: secret)
DB_PASSWORD=secret

# Opcional — URL do frontend (default: http://localhost)
FRONTEND_URL=http://localhost

# Obrigatório para receber sinais HMAC do canário WA-JS.
COMPATIBILITY_INGEST_SECRET=troque-por-um-segredo-aleatorio

# Chave AES-256 em base64 para segredos dos webhooks de clientes.
# Gere com: openssl rand -base64 32
WEBHOOK_ENCRYPTION_KEY=

# Intervalo do worker de entrega dos webhooks de compatibilidade.
COMPATIBILITY_WEBHOOK_POLL_MS=5000
