{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "functions": {
    "api/index.ts": {
      "includeFiles": "migrations/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/compatibility/deliveries/drain",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/telemetry/retention",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/internal/catalog/drain",
      "schedule": "* * * * *"
    }
  ]
}
